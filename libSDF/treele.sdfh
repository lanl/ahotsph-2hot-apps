# SDF - header for littleendian (i.e., i860, VAX, decmips, other intel) .tree files
/*
    SDF Library for reading Self-Describing Files
    Copyright (C) 1991,1992  John K. Salmon

    Terms and conditions are specified in the file "copyright.h",
    and more precisely in the file COPYING.LIB which you should have
    received with this library.
*/
parameter byteorder=0x78563412; /* ??????? */
float npart;			/* 0 */
float iter;			/* 1 */
float time;			/* 2 */
float ke;			/* 3 */
float pe;			/* 4 */
float masstot;			/* 5 */
float l_ang;			/* 6 */
float Gnewt;			/* 7 */
float epsilon;			/* 8 */
float zinitial;			/* 9 */
float omega;			/* 10 */
float hubble;			/* 11 */
float box_size;			/* 12 */
float znow;			/* 13 */
float initial_rsize;		/* 14 */
float initial_rmin_x;		/* 15 */
float initial_rmin_y;		/* 16 */
float initial_rmin_z;		/* 17 */
float veltime;			/* 18 */
float sizeof_ext;		/* 19 */
float alpha;			/* 20 */
float beta;			/* 21 */
float curvature;		/* 22 */
float lambda;			/* 23 */
float cosm_integral;		/* 24 */
float radius;			/* 25 */
int int_npart;			/* 26 */
int int_sizeof_ext;		/* 27 */
float halocenterx;		/* 28 */
float halocentery;		/* 29 */
float halocenterz;		/* 30 */
float tree_header_pad;		/* 31 */
char tree_header_text[384];	/* 384 = 512 - 32*sizeof(float) */
struct { 
    float mass;
    float x, y, z;
    char id[4];
    float vx, vy, vz;
} [] ;
# SDF-EOH
