data "initial2_sph.99000-grid" sdfread
data grid_sph.99000 sdfread
set gridr=sqrt(x*x + y*y +z*z)
set gridlr = lg(gridr)
set gridlrho=lg(rho+1e-30)


data "initial2_sph.99000" sdfread
set r=sqrt(x*x + y*y +z*z)
set lr = lg(r)
set lrho=lg(rho)

device x11
erase
ctype black
limits lr lrho
points lr lrho
box
ctype blue
points gridlr gridlrho

erase 
limits gridlr gridlrho
points gridlr gridlrho
box
