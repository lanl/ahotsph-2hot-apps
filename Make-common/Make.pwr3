# make CC=xlC will inline the sqrt calls, cc doesn't

# sp2 crashes sometimes with our malloc

EXTRACFLAGS:=-DUSE_SYSTEM_MALLOC

defaultCC:=xlc
defaultFC:=xlf

ifeq ($(CC),gcc)

ifeq ($(ARCH),pwr3)
CC_SPECIFIC:=-mcpu=630 -Wa,-many
ifeq ($(FC),g77)
FC_SPECIFIC:=-mcpu=630 -Wa,-many
FOPTIMIZE:=-O4
else
FC_SPECIFIC:=-qtune=pwr3 -qarch=pwr3 -qmaxmem=65536
endif
else
CC_SPECIFIC:=-mcpu=rios3 -Wa,-mpwrx
override CC_SPECIFIC:=$(CC_SPECIFIC) -gxcoff -Wall -ffast-math
endif

else

OPTIMIZE:=-O2
FOPTIMIZE:=-O3 -qstrict
AGGRESSIVE_OPT:=-O4

ifeq ($(ARCH),pwr)
CC_SPECIFIC:=-qfloat=hsflt -qarch=pwr
else
CC_SPECIFIC:=-qfloat=hsflt -qtune=pwr3 -qarch=pwr3 -qmaxmem=65536 -qinline=0 -qinline+StkAlign:StkPush:StkPushData:StkPeek:StkClear:StkBase:StkSz:StkTop
FC_SPECIFIC:=-qtune=pwr3 -qarch=pwr3 -qmaxmem=65536

endif

endif

include $(treedir)/Make-common/Make.default

asmdir:=asm-power
swsrc:=gnusort.c lsv.c sigio_dump.c

ifeq ($(PAROS),mpi)
LD=$(CC) -binitfini:poe_remote_main
LOADLIBES:= $(LOADLIBES) -L/usr/lpp/ppe.poe/lib -L/usr/lpp/ppe.poe/lib/ip -lmpi -lvtd -lm 
PAROSCFLAGS:=-I/usr/lpp/ppe.poe/include
endif

#PRELOAD:=-L/usr/common/usg/gcc/3.0.4/lib/gcc-lib/rs6000-ibm-aix4.3.3.0/3.0.4/power -lgcc
#LD=ld $(LDFLAGS) -b32 /lib/crt0.o -bh:4 -bpT:0x10000000 -bpD:0x20000000 -binitfini:poe_remote_main $(PRELOAD)
