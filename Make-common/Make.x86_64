defaultCC:=icc
defaultFC:=ifort -nofor_main

CC_SPECIFIC:=-g -debug inline-debug-info
FC_SPECIFIC:=-g
ARCH_SPECIFIC:=-D__iX86__=686 -D__ICC__ -DUSE_SYSTEM_MALLOC -DLONG_LONG_KEYS -DYY_SKIP_YYWRAP
OPTIMIZE:=-O3 -static -no-prec-div -xHost
AGGRESSIVE_OPT=-O3 -static -no-prec-div -xHost
LEX:=flex
YACC:=bison -y
RANLIB:=ranlib
LOADLIBES:=-lsvml

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c swampi.c

ifeq ($(PAROS),mpi)
LOADLIBES:=-L$(MPIHOME)/lib -lmpi -lsvml
PAROSCFLAGS:=-I$(MPIHOME)/include
endif
