# As for sun4 case, but you don't need to ranlib anymore
# added __SUN5__ to modify stuff in protos.h, gnusort.c, & sysdep_seq
defaultPAROS:=seq
# This stuff is really generic.  Maybe hould we do another level of
# includes?
ifeq (X$(PAROS),X)
PAROS:=$(defaultPAROS)
endif

ifeq ($(PAROS),$(defaultPAROS))
PAROSsuf:=
else
PAROSsuf:=-$(PAROS)
endif
######### down to here. 

defaultCC:=gcc
LD:=gcc
ARCH_SPECIFIC:=-D__SUN5__
swsrc:=lsv.c swampi.c sigio_dump.c
objsuf:=.o
libext:=.a
asmdir:=asm-sun4
asmsrc:=
RANLIB:=/bin/true
LOADLIBES:=-lsocket -lnsl

include $(treedir)/Make-common/Make.default

ifeq ($(PAROS),lsv)
PAROSsuf:=-lsv
endif

ifeq ($(PAROS),pvm)
extralib:=$(PVMDIR)/lib/$(PVM_ARCH)/libpvm3.a
PAROSsuf:=-pvm
endif

ifeq ($(PAROS),cm5)
LD:=cmmd-ld
LDFLAGS:=-comp $(CC)
PAROSsuf:=-cm5
endif
