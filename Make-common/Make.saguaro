defaultCC:=icc
defaultFC:=ifort -nofor_main

CC_SPECIFIC:=-g -DLONG_LONG_KEYS $(BURNERFLAGS)
FC_SPECIFIC:=-80 $(BURNERFLAGS)
ARCH_SPECIFIC:=-D__iX86__=686 -D__ICC__ -DUSE_SYSTEM_MALLOC -DYY_SKIP_YYWRAP
OPTIMIZE:=-O3 -static -no-prec-div -xP
AGGRESSIVE_OPT=-O3 -static -no-prec-div -xP
LEX:=flex
YACC:=bison -y
RANLIB:=ranlib
LOADLIBES:=-lsvml

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c swampi.c

ifeq ($(PAROS),mpi)
LOADLIBES:=-L/packages/intel-openmpi-1.2.7/lib -lmpi -lsvml -lifcore -lifport 
PAROSCFLAGS:=-I/packages/intel-openmpi-1.2.7/include 
endif

