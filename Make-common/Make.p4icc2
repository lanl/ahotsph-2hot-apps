# Make sure path is set to use icc/ifc 7.1

defaultCC:=icc
defaultFC:=ifc

CC_SPECIFIC:=-DLONG_LONG_KEYS
FC_SPECIFIC:=
ARCH_SPECIFIC:=-D__iX86__=686 -march=pentium4 -mcpu=pentium4 -D__ICC__ -align -Zp8 -ip -ipo -ipo_obj -vec_report4
# PROFILE:=-pg -prof_gen -prof_dir${HOME}/sph/profile

# ARCH_SPECIFIC:=-DUSE_SYSTEM_MALLOC

override OPTIMIZE=-O3 -tpp7 -xW
override AGGRESSIVE_OPT=
# LDFLAGS:=
LOADLIBES:=-L/ss1-raid/opt/intel/compiler71/compiler70/ia32/lib -lm -lsvml
LEX:=flex
YACC:=bison -y

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c swampi.c

ifeq ($(PAROS),mpich)
LOADLIBES:=-L/ss1-raid/local/mpich-1.2.5-ssh/lib -lmpich
PAROSCFLAGS:=-I/ss1-raid/local/mpich-1.2.5-ssh/include
endif

ifeq ($(PAROS),mpich2)
LOADLIBES:=-L/ss1-raid/local/mpich2-0.92/lib -lmpich
PAROSCFLAGS:=-I/ss1-raid/local/mpich2-0.92/include
endif

ifeq ($(PAROS),lam)
LOADLIBES:=-L/usr/local/lib -lmpi -llam
PAROSCFLAGS:=-I/usr/local/include
endif

ifeq ($(PAROS),pvm)
LOADLIBES:=-L/usr/local/pvm3/lib/LINUX -lpvm3
PAROSCFLAGS:=-I/usr/local/pvm3/include
endif
