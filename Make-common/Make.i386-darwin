defaultCC:=gcc
defaultFC:=gfortran

CC_SPECIFIC:=-g -Wall
FC_SPECIFIC:=-g
ARCH_SPECIFIC:=-DUSE_SYSTEM_MALLOC -DYY_SKIP_YYWRAP -DLONG_LONG_KEYS -fno-common

override OPTIMIZE=-O3
override AGGRESSIVE_OPT=-O3
# LDFLAGS:=
LEX:=flex
YACC:=bison -y
RANLIB:=ranlib

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c swampi.c

ifeq ($(PAROS),mpi)
LOADLIBES:=-L/usr/local/lib -lmpi
PAROSCFLAGS:=-I/usr/local/include
endif
