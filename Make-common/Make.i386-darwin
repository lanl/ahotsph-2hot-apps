defaultCC:=gcc
defaultFC:=gfortran

CC_SPECIFIC:=-DLONG_LONG_KEYS -Wno-long-double -g -fno-common
FC_SPECIFIC:=
ARCH_SPECIFIC:=-DUSE_SYSTEM_MALLOC -DYY_SKIP_YYWRAP

override OPTIMIZE=
override AGGRESSIVE_OPT=
# LDFLAGS:=
LEX:=flex
YACC:=bison -y
RANLIB:=ranlib

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c swampi.c

ifeq ($(PAROS),mpi)
LOADLIBES:=-L$(HOME)/lib -lmpi
PAROSCFLAGS:=-I$(HOME)/include
endif
