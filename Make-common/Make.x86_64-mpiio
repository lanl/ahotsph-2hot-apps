defaultCC:=icc
defaultFC:=ifort -nofor_main

CC_SPECIFIC:=-g -DLONG_LONG_KEYS
FC_SPECIFIC:=-80
ARCH_SPECIFIC:=-D__iX86__=686 -D__ICC__ -DUSE_SYSTEM_MALLOC
OPTIMIZE:=-O3 -static -no-prec-div -xW
AGGRESSIVE_OPT=-O3 -static -no-prec-div -xW
LEX:=flex
YACC:=bison -y
RANLIB:=ranlib
LOADLIBES:=-lsvml

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c swampi.c

ifeq ($(PAROS),mpi)
LOADLIBES:=-L$(MPIHOME)/lib64 -lmpi -lsvml
PAROSCFLAGS:=-I$(MPIHOME)/include -DUSE_MPIIO
endif
