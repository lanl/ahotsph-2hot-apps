defaultCC:=icc -static
defaultFC:=ifc -static

CC_SPECIFIC:=
FC_SPECIFIC:=-O3 -tpp7 -xW
ARCH_SPECIFIC:=-D__iX86__=686 -D__ICC__ -D_FILE_OFFSET_BITS=64
override OPTIMIZE=-O3 -tpp7 -xW 
override AGGRESSIVE_OPT=-O3 -tpp7 -xW 
LOADLIBES:=-lsvml
LEX:=flex
YACC:=bison -y

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c swampi.c

ifeq ($(PAROS),mpi)
LOADLIBES:=-L/usr/local/mpich/lib/LINUX/ch_p4 -lmpi
PAROSCFLAGS:=-I/usr/local/mpich/include
endif

ifeq ($(PAROS),lam)
LOADLIBES:=-L/usr/local/lam/lib -lmpi -ltstdio -ltrillium -largs -lt
PAROSCFLAGS:=-I/usr/local/lam/h
endif

ifeq ($(PAROS),pvm)
LOADLIBES:=-L/usr/local/pvm3/lib/LINUX -lpvm3
PAROSCFLAGS:=-I/usr/local/pvm3/include
endif
