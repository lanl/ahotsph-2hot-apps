defaultPAROS:=mpi
# This stuff is really generic.  Maybe hould we do another level of
# includes?
ifeq (X$(PAROS),X)
PAROS:=$(defaultPAROS)
endif

ifeq ($(PAROS),$(defaultPAROS))
PAROSsuf:=
else
PAROSsuf:=-$(PAROS)
endif
######### down to here. 

CC:=cc.mpi
LD:=cc.mpi -cell -ddv
CFLAGS:=-g -Wall -O2 -DUSE_SYSTEM_MALLOC -D__AP1000__
objsuf:=.o
libext:=.a
#asmdir:=asm-sun4
asmsrc:=
