# Makefile for IRIX64, i.e., the 64-bit SGI OS.  It's hard to tell
# what we should really use for ARCH on SGI.  They don't have an `arch`
# command, and uname -m returns either IP22 or IP21, which don't
# seem to be mnemonic for anything.  uname -s returns IRIX32 or IRIX64,
# which at least means something to me...
ifeq ($(CC),cc)
# O3 is "aggressive" optimization.  fast_sqrt says to use the
# rsqrt instruction.  This returns a NaN for sqrt(0), so it introduces
# yet another restriction on the code.  The IEEE_arithmetic=3
# says to do dangerous rearrangements that might
# impact ieee conformance (e.g., x/y -> x*recip(y) ).  See man cc for details.
OPTIMIZE:= -64 -O3 -OPT:fast_sqrt -OPT:IEEE_arithmetic=3
LDFLAGS:= -64
CC_SPECIFIC:=-D__STDC__ -g3 -DLONG_NK1_KEY -DSTK_FORCE_ALIGNMENT=8 -DUSE_SYSTEM_MALLOC
endif

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c

ifeq ($(PAROS),mpi)
LOADLIBES:= -lmpi
endif

