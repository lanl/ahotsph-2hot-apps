defaultFC:=f77
ifeq ($(CC),cc)
OPTIMIZE:= -n32 -O3 -OPT:fast_sqrt -OPT:IEEE_arithmetic=3
LDFLAGS:= -n32
CC_SPECIFIC:=-D__STDC__ -g3 -DSTK_FORCE_ALIGNMENT=8 -DUSE_SYSTEM_MALLOC
endif

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c

ifeq ($(PAROS),mpi)
LOADLIBES:= -lmpi
endif

ifeq ($(PAROS),mpich)
LOADLIBES:=-L/usr/local/mpich/lib/IRIXN32/ch_shmem -lmpi
PAROSCFLAGS:=-I/usr/local/mpich/include
endif
