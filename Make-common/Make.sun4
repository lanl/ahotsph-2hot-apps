defaultCC:=gcc

ARCH_SPECIFIC=-D__SUN4__

# Sun ansi C compiler which comes with /usr/lang 
ifeq ($(CC),acc)
OPTIMIZE:=-fast
CC_SPECIFIC:=-D_SUNACC
endif

ifeq ($(CC),insight)
OPTIMIZE:=-O2
CC_SPECIFIC:=-D__inline__=static -DUSE_SYSTEM_MALLOC
CC_SPECIFIC:=$(CC_SPECIFIC) -g -Wall -ffast-math
endif

include $(treedir)/Make-common/Make.default

RANLIB:=/usr/bin/ranlib
asmdir:=asm-sun4
swsrc:=memmove.c lsv.c swampi.c raise.c gnusort.c sigio_dump.c

ifeq ($(PAROS),cm5)
LD:=cmmd-ld
LDFLAGS:=-comp $(CC)
endif

ifeq ($(PAROS),cm5na)
ifdef NO_VU
LD:=cmmd-ld
LDFLAGS:=-comp $(CC)
PAROSsuf:=$(PAROSsuf)-novu
else
asmdir:=asm-cm5
swsrc:=$(swsrc) do_grav_fast.c
ACC:=ac
LDFLAGS:=-comp ac
PAROSCFLAGS:=-D__CM5VU__
Objfiles/sun4/grav_nv.o: grav_nv.c
	$(CC) $(CFLAGS) -D__CM5VU__ -c $<
	mv grav_nv.o $@
endif
endif

# This paths here are for CM5-mpi only (as installed at ANU).
# I even -D__CM5__ to get the IO right.  If we ever use another sun4 mpi,
# then this one should probably get changed to PAROS="cm5-mpi", and
# an appropriate mpmy_cm5-mpi.c should be created (two lines long?).
ifeq ($(PAROS),mpi)
LD:=cmmd-ld
LDFLAGS:=-comp $(CC)
LOADLIBES:=-L/usr/new/mpi/lib -lmpi
PAROSCFLAGS:=-I/usr/new/mpi/include -D__CM5__
endif

ifdef EFENCE
LOADLIBES:= $(treedir)/Objfiles/$(ARCH)/libefence.a
PAROSsuf:=$(PAROSsuf)-efence
endif



