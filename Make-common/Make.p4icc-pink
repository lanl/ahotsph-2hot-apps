# INTEL_LICENSE_FILE:=/opt/Intel/fortran/8.1/licenses/license.dat:/opt/Intel/c/8.1/licenses/license.dat
defaultCC:=icc
defaultFC:=ifort -nofor_main

CC_SPECIFIC:=-DLONG_LONG_KEYS -march=pentium4 -mcpu=pentium4
FC_SPECIFIC:=
ARCH_SPECIFIC:=-D__iX86__=686 -D__ICC__ -align -Zp8 -DUSE_SYSTEM_MALLOC
# ARCH_SPECIFIC:=-D__iX86__=686 -D__ICC__ -align -Zp8 -DUSE_SYSTEM_MALLOC

# ARCH_SPECIFIC:=-DUSE_SYSTEM_MALLOC

override OPTIMIZE=-O2 -tpp7 -xW
override AGGRESSIVE_OPT=
LOADLIBES:=-lsvml
LEX:=flex
YACC:=bison -y

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c swampi.c

ifeq ($(PAROS),mpi)
# MPIHOME:=/opt/lampi/lampi-1.5.12/gm
LOADLIBES:=-L$(MPIHOME)/lib -lmpi -lsvml
PAROSCFLAGS:=-I$(MPIHOME)/include
endif

ifeq ($(PAROS),mpich)
LOADLIBES:=-L$(MPIHOME)/lib -lmpich -lgm -lpthread -lsvml
PAROSCFLAGS:=-I$(MPIHOME)/include
endif

ifeq ($(PAROS),mpich2)
LOADLIBES:=-L/ss1-raid/local/mpich2-0.92/lib -lmpich
PAROSCFLAGS:=-I/ss1-raid/local/mpich2-0.92/include
endif

ifeq ($(PAROS),lam)
LOADLIBES:=-L/usr/local/lib -lmpi -llam
PAROSCFLAGS:=-I/usr/local/include
endif

ifeq ($(PAROS),pvm)
LOADLIBES:=-L/usr/local/pvm3/lib/LINUX -lpvm3
PAROSCFLAGS:=-I/usr/local/pvm3/include
endif
