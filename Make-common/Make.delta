defaultPAROS:=nx
defaultCC:=i860-delta-gcc
CC:=$(defaultCC)

ifeq ($(CC),$(defaultCC))
OPTIMIZE:=-O2
CC_SPECIFIC:=-Wall
else
CC_SPECIFIC:=-nx
OPTIMIZE:=-O2
AGGRESSIVE_OPT=-O4 -Knoieee
LDFLAGS:=-nx
endif

ARCH_SPECIFIC:=-D__INTEL_SSD__ -D__DELTA__
AS=delta as860

include $(treedir)/Make-common/Make.default

ifeq ($(CC),icc)
override CC:=delta icc
override LD:=delta icc
endif

asmdir=asm-i860
AR=delta ar860
RANLIB=/usr/bin/ranlib
DELTA=delta2
swsrc:=memmove.c bcopy.c raise.c gnusort.c ivfprintf.c
asmsrc=recipsqrtf.s sqrtf.s do_grav_fast.s

# How do we finish linking??
finishlink= cp $@ $@.sym && delta strip860 $@ && rcp $@ $(DELTA):


