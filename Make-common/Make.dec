defaultCC:=cc
defaultFC:=f77
override LD=cc

CC_SPECIFIC:=-non_shared
FC_SPECIFIC:=-fast
OPTIMIZE=-O3
LDFLAGS:=-non_shared
ARCH_SPECIFIC:=-DLONG_NK1_KEY -DSTK_FORCE_ALIGNMENT=8
AGGRESSIVE_OPT=-O4 -fast
LEX:=lex
YACC:=bison -y

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c swampi.c

ifdef fsrc
LOADLIBES:=-lFS -lfor -lFutil
endif

ifeq ($(PAROS),mpi)
LOADLIBES:=-L/usr/local/mpich/lib/LINUX/ch_p4 -lmpi
PAROSCFLAGS:=-I/usr/local/mpich/include
endif

ifeq ($(PAROS),lam)
LOADLIBES:=-L/usr/local/lam/lib -lmpi -ltstdio -ltrillium -largs -lt
PAROSCFLAGS:=-I/usr/local/lam/h
endif

ifeq ($(PAROS),pvm)
LOADLIBES:=-L/usr/local/pvm3/lib/LINUX -lpvm3
PAROSCFLAGS:=-I/usr/local/pvm3/include
endif

ifeq ($(PAROS),mpisw)
LOADLIBES:=-L/u/msw/mpich/lib/LINUX/ch_sw -lmpi -L$(TREEHOME)/Objfiles/$(ARCH) -lsw
PAROSCFLAGS:=-I/usr/local/mpich/include
endif
