dopanel      	data panel_d4.0 
		sdfread
		limits -1.2 1.2 -1.2 1.2
		box
		old_pairs x1 y1 x2 y2
		old_pairs x2 y2 x3 y3
		old_pairs x3 y3 x1 y1
		set x=.333333*(x1+x2+x3)
		set y=.333333*(y1+y2+y3)
		ptype 0 0
		points x y
        	data panel.010
		sdfread {strx stry}
		vecstrength x y strx stry
		xlabel x
		ylabel y

