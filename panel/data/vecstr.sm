# Plot a vector field of the strength vectors, scaled
# correctly fit the current window (?).
define vecstr_scale 1.0
vecstrength	14 
		define pi 3.141592
		set ang=(180./$pi)*atan2( $4/($fy2 - $fy1), $3/($fx2 - $fx1))
		set len=sqrt($3*$3 + $4*$4)
		stats len lenmean lensig lenkurt
		set len=$vecstr_scale*len/$lenmean
		vfield $1 $2 len ang
		ctype default
