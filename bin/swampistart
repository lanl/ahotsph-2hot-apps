#!/bin/bash
# The name of this very program, so we can call it again through rsh...
mpi_start_prog=$TREEHOME/bin/`basename $0`
# Recursion is EXTERMELY BAD.  It can crash (or at least stop) the host
# so we take precautions against calling ourselves recursively
: ${MPI_RECURSION:=0}
if [ $MPI_RECURSION -ge 2 ]; then
  echo Bailing out of recursive call of $0!
  exit 1
fi  
MPI_RECURSION=`expr $MPI_RECURSION + 1`
export MPI_RECURSION MPI_PROCNUM
# ssh is nice, but it doesn't propagate signals!  Kill'ing the local
# ssh doesn't send a signal to the remote jobs!
# -a prevents us from forwarding auth agent connections.
# -x prevents forwarding of X11
# -c none would eliminate encryption, but that's not allowed on naegling(?)
#: ${MPI_RSH="ssh -n -a -x"}
#: ${MPI_RSH:="ssh -n -a -x -c none"}
: ${MPI_RSH:="rsh -n"}
# initialize pids with the pid of the 'host' srv process that is
# exchanging addresses with the nodes.  We 'wait' for this along with
# all the elt pids at the end.
pids=$MPI_PID
# trap most signals to try to kill everything when things go bad.
# we used to trap 18 (SIGTSTP), but on sysV, 18 is SIGCHLD.  Since there's
# no symbolic way to refer to signals, we just leave it out for now.
for sig in 3 4 6 8 10 15; do
  trap   "echo ${HOSTNAME}:$0: kill -$sig \$pids
	kill -$sig \$pids
	# SIGINT doesn't necessarily work.  Try 15:
	sleep 5;
	echo ${HOSTNAME}:$0: kill -15 \$pids
	kill -15 \$pids > /dev/null 2>&1
	# and if that didn't work, try kill -9
	sleep 5;
	echo ${HOSTNAME}:$0: kill -9 \$pids
	kill -9 \$pids > /dev/null 2>&1 
	exit 1;" $sig
done

# SIGINT (2) is handled separately, why?
trap   "echo ${HOSTNAME}:$0: trapped signal 2 kill -15 \$pids
	kill -15 \$pids > /dev/null 2>&1
	exit 1;" 2
#
if [ $MPI_VERBOSE ] ; then
  echo $0:MPI_NPROC $MPI_NPROC
  echo $0:MPI_HOST $MPI_HOST
  echo $0:MPI_HOSTPORT $MPI_HOSTPORT
  echo $0:MPI_PROGELT $MPI_PROGELT
  echo $0:MPI_SUSPEND $MPI_SUSPEND
  echo $0:MPI_TIMEOUT $MPI_TIMEOUT
  echo $0:MPI_MESSAGE_TURNON $MPI_MESSAGE_TURNON
  echo $0:MPI_RECURSION $MPI_RECURSION
  echo $0:MPI_REMOTE $MPI_REMOTE
fi
#
if [ "$MPI_REMOTE" ] ; then
  # In this case, we start some rsh which in turn start the elt progs
  # Doing arithmetic in sh is a real pain!
  nremote=0
  for word in $MPI_REMOTE; do
    nremote=`expr $nremote + 1`
  done
  nperremote=`expr $MPI_NPROC / $nremote`
  leftover=`expr $MPI_NPROC % $nremote`
  if [ $leftover -gt 0 ]; then
    nperremote=`expr $nperremote + 1`
  fi
  if [ $MPI_VERBOSE ]; then
    echo nperremote=$nperremote, leftover=$leftover
  fi
  first=0;
  # How should we call the 'mpistart' on the remote
  # node??  I've called it mpi_start_prog, which is set at the top of
  # the file, but there's no guarantee that it will be in the same place
  # on the remote machine.
  # A similar difficulty arises with the cd $PWD, that's passed to the
  # remote execution.  Here is not necessarily the same over there.
  # Another problem is arguments with shell meta-chars.
  # The following bit of madness embeds another layer of quotes into args.
  # This seems to be enough to handle embedded spaces, but embedded quotes
  # are still too much for it.  There MUST be a better way!!!
  # We don't pass MPI_SUSPEND because the remote processes are typically
  # owned by root, so you can't attach to them anyway.
args="`cat <<!
$@
!`"
  i=0
  for remote in $MPI_REMOTE ; do
    last=`expr $first + $nperremote`
    if [ $MPI_VERBOSE ] ; then
      echo i=$i starting $first through `expr $last - 1` on $remote
    fi
    $MPI_RSH $remote /bin/sh -c "\"cd $PWD;\
	MPI_RECURSION=$MPI_RECURSION\
	MPI_NPROC=$MPI_NPROC\
	MPI_FIRST=$first\
	MPI_LAST=$last\
	MPI_HOST=$MPI_HOST\
	MPI_HOSTPORT=$MPI_HOSTPORT\
	MPI_PROGELT=$MPI_PROGELT\
	MPI_VERBOSE=$MPI_VERBOSE\
	MPI_TIMEOUT=$MPI_TIMEOUT\
	MPI_MESSAGE_TURNON=$MPI_MESSAGE_TURNON\
	$mpi_start_prog $args \"" &
    pids="$pids $!"
    first=$last
    i=`expr $i + 1`
    if [ $i = $leftover ] ; then
      nperremote=`expr $nperremote - 1`
      if [ $nperremote = 0 ] ; then
        break;
      fi
    fi
  done
else
  : ${MPI_FIRST:=0}
  : ${MPI_LAST:=$MPI_NPROC}
  MPI_PROCNUM=$MPI_FIRST
  while [ $MPI_PROCNUM -lt $MPI_LAST ]; do
    $MPI_PROGELT "$@" &
    pids="$pids $!"
    MPI_PROCNUM=`expr $MPI_PROCNUM + 1`
  done
fi
#
if [ $MPI_VERBOSE ]; then
  echo waiting
fi
wait

if [ $MPI_VERBOSE ]; then
  echo $0: done
fi
exit
