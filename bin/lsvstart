#!/bin/sh
# The name of this very program, so we can call it again through rsh...
lsv_start_prog=$TREEHOME/lsv/`basename $0`
# Recursion is EXTERMELY BAD.  It can crash (or at least stop) the host
# so we take precautions against calling ourselves recursively
: ${LSV_RECURSION:=0}
# If LSV_RSH isn't set, use ssh with no encryption.
#: ${LSV_RSH:="ssh -a -c none"}
: ${LSV_RSH:="rsh"}
if [ $LSV_RECURSION -ge 2 ]; then
  echo Bailing out of recursive call of $0!
  exit 1
fi  
LSV_RECURSION=`expr $LSV_RECURSION + 1`
export LSV_RECURSION LSV_PROCNUM
# initialize pids with the pid of the 'host' srv process that is
# exchanging addresses with the nodes.  We 'wait' for this along with
# all the elt pids at the end.
pids=$LSV_PID
# trap most signals to try to kill everything when things go bad.
# we used to trap 18 (SIGTSTP), but on sysV, 18 is SIGCHLD.  With bash,
# one can use symbolic names to refer to signals, but older shells can't.
# sigh...
for sig in 2 3 4 6 8 10 15; do
  trap   "echo $0: trapped $sig on `hostname`.  Outahere
	echo $0: kill -$sig \$pids
	kill -$sig \$pids
	# SIGINT doesn't get the attention of rsh, so try 15.
        sleep 90
	echo $0: kill -15 \$pids
	kill -15 \$pids
	# and if that didn't work, how about 9
        sleep 90
	echo $0: kill -9 \$pids
	kill -9 \$pids
	exit 1;" $sig
done
# rather than figure out the substitution INSIDE all those quotes, 
# just do the SIGINT case separately
trap   "echo $0: trapped $sig on `hostname`.  Outahere
	echo $0: kill -15 \$pids
	kill -15 \$pids
	exit 1;" 2
#
if [ $LSV_VERBOSE ] ; then
  echo $0:LSV_NPROC $LSV_NPROC
  echo $0:LSV_HOST $LSV_HOST
  echo $0:LSV_MYNAME $LSV_MYNAME
  echo $0:LSV_HOSTPORT $LSV_HOSTPORT
  echo $0:LSV_PROGELT $LSV_PROGELT
  echo $0:LSV_SUSPEND $LSV_SUSPEND
  echo $0:LSV_RECURSION $LSV_RECURSION
  echo $0:LSV_REMOTE $LSV_REMOTE
fi
#
if [ "$LSV_REMOTE" ] ; then
  # In this case, we start some rsh which in turn start the elt progs
  # Doing arithmetic in sh is a real pain!
  nremote=0
  for word in $LSV_REMOTE; do
    nremote=`expr $nremote + 1`
  done
  nperremote=`expr $LSV_NPROC / $nremote`
  leftover=`expr $LSV_NPROC % $nremote`
  if [ $leftover -gt 0 ]; then
    nperremote=`expr $nperremote + 1`
  fi
  if [ $LSV_VERBOSE ]; then
    echo nperremote=$nperremote, leftover=$leftover
  fi
  first=0;
  # How should we call the 'lsvstart' on the remote
  # node??  I've called it lsv_start_prog, which is set at the top of
  # the file, but there's no guarantee that it will be in the same place
  # on the remote machine.
  # A similar difficulty arises with the cd $PWD, that's passed to the
  # remote execution.  Here is not necessarily the same over there.
  # Another problem is arguments with shell meta-chars.
  # The following bit of madness embeds another layer of quotes into args.
  # This seems to be enough to handle embedded spaces, but embedded quotes
  # are still too much for it.  There MUST be a better way!!!
  # We don't pass LSV_SUSPEND because the remote processes are typically
  # owned by root, so you can't attach to them anyway.
args="`cat <<!
$@
!`"
  i=0
  for remote in $LSV_REMOTE ; do
    if [ $nperremote -le 0 ]; then break; fi # no more rsh if we're done
    last=`expr $first + $nperremote`
    if [ $LSV_VERBOSE ] ; then
      echo starting $first through `expr $last - 1` via $LSV_RSH $remote ...
    fi
    $LSV_RSH $remote /bin/sh -c "\"cd $PWD;\
	LSV_RECURSION=$LSV_RECURSION\
	LSV_NPROC=$LSV_NPROC\
	LSV_FIRST=$first\
	LSV_LAST=$last\
	LSV_HOST=$LSV_HOST\
	LSV_MYNAME=$remote\
	LSV_HOSTPORT=$LSV_HOSTPORT\
	LSV_PROGELT=$LSV_PROGELT\
	LSV_VERBOSE=$LSV_VERBOSE\
	$lsv_start_prog $args \"" &
    pids="$pids $!"
    first=$last
    i=`expr $i + 1`
    if [ $i = $leftover ] ; then
      nperremote=`expr $nperremote - 1`
    fi
  done
else
  : ${LSV_FIRST:=0}
  : ${LSV_LAST:=$LSV_NPROC}
  LSV_PROCNUM=$LSV_FIRST
  if [ $LSV_VERBOSE ] ; then
   echo lsvstart on `hostname`:`pwd`, running: "$LSV_PROGELT" "$@"
  fi
  while [ $LSV_PROCNUM -lt $LSV_LAST ]; do
    $LSV_PROGELT "$@" &
    pids="$pids $!"
    LSV_PROCNUM=`expr $LSV_PROCNUM + 1`
  done
fi
#
if [ $LSV_VERBOSE ]; then
  echo waiting, lsvstart on `hostname`
fi
wait

if [ $LSV_VERBOSE ]; then
  echo $0: done on `hostname`
fi
exit
