#!/bin/sh
# Renamed to 'Paragon' because 'uname -m' on the paragon returns 'paragon',
# so I need to have a directory called ~/bin/paragon...Sigh
#
# Usage:
#  paragon program args
# 
# This script is a wrapper for paragon-specific utilities (e.g., icc).  
# It is intended
# to simplify life for people who develop for delta, paragon and/or gamma.
# The problem is that one uses exactly the same set of utilities for each
# target.  Three environment variables are used to distinguish the different 
# targets:  PATH, IPSC_XDEV (or PARAGON_XDEV) and PGI.  This script is
# the solution.
#  This script sets these environment vars correctly and then runs
# the named program with the given arguments.  I have tried to arrange
# that all types of wierd quoting mechanisms are passed unmolested.  I'm
# not entirely sure I've succeeded.  You should be able to do:
# paragon icc "-DGREETING=\"Hello world\\\n\"" greet.c
# Cross your fingers!
#
# It is perhaps desirable to fold all three of these scripts (delta, paragon,
# gamma) into a single script with a switch on $0.  I don't feel ambitious.
#
# It is worth noting that there is another possible solution to this problem
# that sets the environment variables in your shell.  Then you can 
# run icc, as860, etc. without a wrapper.  See the program i860_target for
# an example of how to do that.  The advantage is that it's slightly less
# to type (and execute) when you run a utility.  The disadvantage is that
# it can be inconvenient for Makefiles.
#
PARAGON_XDEV=/usr/local/paragon
# Now scan the argument list looking for one of our keywords
verbose=0
while : ; do
  case $1 in
  -exp|-r1.2)
    echo the default is 1.2 now.  Using default.
    #PARAGON_XDEV=/usr/local/paragon_r1.2
    ;;
  -old)
    echo setting environment for t13 paragon
    PARAGON_XDEV=/usr/local/paragon_t13
    ;;
  -v)
    verbose=1;
    ;;
  *)
    break;
    ;;
  esac
  shift;
done

PATH=$PARAGON_XDEV/paragon/bin.sun4:$PATH
MANPATH=$PARAGON_XDEV/paragon/man:$MANPATH
PGI=$PARAGON_XDEV
export PATH PGI PARAGON_XDEV MANPATH
if [ $verbose = 1 ] ; then
    echo PGI=$PGI
    echo PARAGON_XDEV=$PARAGON_XDEV
    echo PATH=$PATH
    echo eval "$@"
fi
# Is this always right???
"$@"

