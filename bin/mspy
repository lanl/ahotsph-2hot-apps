# 
# This should work with csh (or msh on the delta)
#
# A little shell script to watch a file that should be growing,
# e.g., the output file from a job.  If the file (first arg) fails to grow
# in a given interval (second arg, in seconds), a loud noise is made
set file=$1
set interval=$2
set nlinesbefore=`wc -c <  $file`
sleep $interval
set nlinesafter=`wc -c <  $file`
while ($nlinesbefore != $nlinesafter)
	set nlinesbefore=$nlinesafter
	sleep $interval
	set nlinesafter=`wc -c <  $file`
end
echo
echo $file length not changing for $interval seconds at:
date
echo ''
sleep 10
echo ''
sleep 10
echo ''
sleep 10
echo ''
sleep 10
echo ''
sleep 10
echo ''
