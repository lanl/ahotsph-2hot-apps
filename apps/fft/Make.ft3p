##### Application-specific stuff goes here

src=ft3p.c four1.c nrutil.c ran1.c
programname=ft3p
treedir=../../../tree16

##### End of application-specific setup
############### NO USER SERVICABLE PARTS BELOW THIS LINE############

include $(treedir)/Make-common/Make.$(ARCH)

incdir=$(treedir)/include
objdir=$(ARCH)
libdir=$(treedir)/$(ARCH)
CFLAGS:=-I$(incdir) $(CFLAGS)

obj=$(patsubst %.c,$(objdir)/%$(objsuf),$(src))
bin=$(programname).$(ARCH)-$(PAROS)

$(objdir)/%$(objsuf) : %.c
	$(CC) $(CFLAGS) -c $<
	-@mv $*$(objsuf) $@

LIBDEPENDS=$(libdir)/sysdep_$(PAROS)$(objsuf) $(libdir)/libsw.a
# If we're going to the trouble to list out the full directory names
# in LIBDEPENDS, there's not much point in making the linker figure them
# out (possibly erroneously) again with -L... -l...
LOADLIBES= $(LIBDEPENDS) -lm

all: $(objdir) $(bin)

$(bin) : $(obj) $(LIBDEPENDS)
	$(LD) $(LDFLAGS) -o $@ $(obj) $(LOADLIBES)
	$(finishlink)

$(objdir) :
	-mkdir $(objdir)

ifeq (X$(MAKEDEPEND),X)
MAKEDEPEND:=echo You must set MAKEDEPEND
endif

depends: 
	$(MAKEDEPEND) '-o$$(objsuf)' '-p$$(objdir)/' -- $(CFLAGS) -- $(src)

# DO NOT DELETE THIS LINE -- make depend depends on it.

$(objdir)/ft3p$(objsuf): ../tree14/include/collective.h
$(objdir)/ft3p$(objsuf): ../tree14/include/bigmalloc.h ../tree14/include/error.h
$(objdir)/ft3p$(objsuf): ../tree14/include/gccextensions.h
$(objdir)/ft3p$(objsuf): ../tree14/include/Msgs.h ../tree14/include/timers.h
$(objdir)/ft3p$(objsuf): nr.h nrutil.h complex.h
