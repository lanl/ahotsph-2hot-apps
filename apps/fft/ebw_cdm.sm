ebw0	ebw_cdm 0.5 1.0 15.3
ebw1	ebw_cdm 0.5 1.0 18.0
ebw2	ebw_cdm 0.5 1.0 20.04
ebw_cdm	3 define h ($1)
	define Omega0 ($2)
	define Tquad ($3*1e-6)
	define a (6.4/($h*$h*$Omega0))
	define b (3.0/($h*$h*$Omega0))
	define c (1.7/($h*$h*$Omega0))
	define nu (1.13)
	define T0 (2.735)
	define c_km_s (2.99792458e5)
	define H0_km_s_Mpc 100
	define factor (($Tquad/$T0)*sqrt(6/5)*pi*(2*$c_km_s/($H0_km_s_Mpc))**2)
	define sqrtA ($factor/(($Omega0**0.77)*$h*$h))
	define r0s(8.0/$h)
	define r0g (3.79/$h)
	define step (.0001)
	set k = $step,1,$step
	set denom = (1+($a*k+($b*k)**1.5+($c*k)**2)**$nu)**(2/$nu)
	set power = $sqrtA*$sqrtA*k/denom
	set variance2 = (k**3)*power/(2*pi*pi)
	set integrand = variance2*exp(-k*k*$r0g*$r0g)/k
	set lp = lg(power)
	set lk = lg(k)
	set lv = lg(variance2)
	set li = lg(integrand)
	limits -2.5 0 2.5 5
	box
	ptype 1 1
	points lk lp
	set s = $step*integrand
	calc sqrt(sum(s))
	# Kolb and Turner p. 330
	set kr = k*$r0s
	set f1 = sin(kr)/(kr**3)
	set f2 = cos(kr)/(kr**2)
	set integrand = 9*variance2*(f1-f2)**2/k
	set s = $step*integrand
	calc sqrt(sum(s))
