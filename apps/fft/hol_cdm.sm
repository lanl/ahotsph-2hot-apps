# COBE normalized baryon=0.05 h=50
hol0	hol_cdm 0.5 1.0 20.04 -0.9876 26.27 43.51 50.45
# COBE normalized baryon=0.01 h=50
hol2	hol_cdm 0.5 1.0 20.04 -0.6789 23.13 41.53 44.13
# baryon=0.01 h=50 nu=0.3 3 species
hol3	hol_cdm 0.5 1.0 20.04 -0.1158 0.2238 164.6 458.3
# baryon=0.01 h=50 nu=0.3 1 species
hol4	hol_cdm 0.5 1.0 20.04 -0.3988 18.43 -3.340 503.0
# baryon=0.01 h=50 nu=0.1 3 species
hol5	hol_cdm 0.5 1.0 20.04 -1.280 24.78 96.80 47.02
# baryon=0.01 h=50 nu=0.1 1 species
hol6	hol_cdm 0.5 1.0 20.04 -0.7911 18.88 85.42 78.35
# baryon=0.10 h=50 nu=0.3 3 species
hol7	hol_cdm 0.5 1.0 20.04 1.348 -27.09 209.1 406.7
# baryon=0.10 h=50 nu=0.3 1 species
hol8	hol_cdm 0.5 1.0 20.04 -0.4678 16.95 12.03 652.1
hol_cdm	7 define h ($1)
	define Omega0 ($2)
	define Tquad ($3*1e-6)
	define t2 ($4)
	define t3 ($5)
	define t4 ($6)
	define t5 ($7)
	define T0 (2.735)
	define c_km_s (2.99792458e5)
	define H0_km_s_Mpc 100
	define sqrtA (($Tquad/$T0)*sqrt(6/5)*pi*(2*$c_km_s/($h*$H0_km_s_Mpc))**2)
	define r0s(8.0/$h)
	define r0g (3.79/$h)
	define step (.0001)
	set k = $step,1,$step
	set denom = (1+$t2*k**0.5+$t3*k+$t4*k**1.5+$t5*k*k)**2 
	set power = $sqrtA*$sqrtA*k/denom
	set variance2 = (k**3)*power/(2*pi*pi)
	set integrand = variance2*exp(-k*k*$r0g*$r0g)/k
	set lp = lg(power)
	set lk = lg(k)
	set lv = lg(variance2)
	set li = lg(integrand)
	limits -2.5 0 2.5 5
	box
	ptype 1 1
	connect lk lp
	set s = $step*integrand
	calc sqrt(sum(s))
	# Kolb and Turner p. 330
	set kr = k*$r0s
	set f1 = sin(kr)/(kr**3)
	set f2 = cos(kr)/(kr**2)
	set integrand = 9*variance2*(f1-f2)**2/k
	set s = $step*integrand
	calc sqrt(sum(s))
