data temp
sdfread
print {x y z mass n}
calc sum(mass)/dimen(mass)
set dm = mass-119744
set dmm = dm/119744
set dmm2 = dmm*dmm
calc sqrt(sum(dmm2)/dimen(dmm2))
calc 1.27115*15.3/20
print {n}
limits x y
erase
box
points x y
calc (4*pi/3)*16000**3
calc 6.94e-9*(4*pi/3)*16000**3
calc sum(mass)/dimen(mass)
sdfread
data cdm1Gb_dmm16.0650
sdfread
set dm = mass-119072
set dmm = dm/119072
set dmm2 = dmm*dmm
calc sqrt(sum(dmm2)/dimen(dmm2))
calc 15.3/20
calc .765*1.14785
quit
